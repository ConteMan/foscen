    "yi": {
      "label": "乙 · 实色",
      "recommended": true,
      "panel": "#10261C",
      "blur": "none",
      "border": "1px solid rgb(114 219 165 / 28%)",
      "radiusPanel": 12,
      "shadow": "0 12px 28px rgb(0 8 5 / 45%)",
      "inset": "inset 0 1px 0 rgb(232 255 242 / 6%)",
