{
  "$comment": "Foscen overlay tokens. Layout is locked. styles.jia/yi/bing are the three visual variants. Default recommendation: yi (solid).",
  "fontFamily": "Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
  "layout": {
    "omnibarMaxWidth": 640,
    "omnibarMaxHeight": 360,
    "surfaceMaxWidth": 720,
    "surfaceMaxHeight": 420,
    "dragStrip": 10,
    "inputRow": 44,
    "input": 36,
    "option": 40,
    "footer": 28,
    "iconButton": 28,
    "icon": 16,
    "close": 28,
    "brandMark": 24,
    "maxVisibleRows": 6,
    "maxVisibleRowsCompact": 4,
    "surfaceHeader": 44,
    "surfaceTab": 36,
    "surfaceRow": 48,
    "omnibarTopRatio": 0.14,
    "omnibarTopMin": 72,
    "omnibarTopMax": 140,
    "surfaceTopRatio": 0.1,
    "surfaceTopMin": 56,
    "surfaceTopMax": 96,
    "sideReserve": 48,
    "narrowWidth": 520,
    "shortHeight": 400
  },
  "type": {
    "input": { "size": 14, "weight": 500, "lineHeight": 20 },
    "optionTitle": { "size": 13, "weight": 600, "lineHeight": 18 },
    "optionMeta": { "size": 11, "weight": 400, "lineHeight": 16 },
    "footer": { "size": 11, "weight": 400, "lineHeight": 16 },
    "surfaceTitle": { "size": 15, "weight": 600, "lineHeight": 20 },
    "tab": { "size": 12, "weight": 500, "lineHeight": 16 },
    "tabActive": { "size": 13, "weight": 600, "lineHeight": 16 },
    "button": { "size": 13, "weight": 700, "lineHeight": 16 }
  },
  "space": {
    "unit": 8,
    "panelX": 8,
    "inputGap": 6,
    "optionX": 12,
    "footerX": 14,
    "footerGap": 14,
    "surfacePad": 16
  },
  "radius": {
    "control": 8,
    "option": 8,
    "kbd": 5,
    "surfaceCard": 10
  },
  "stroke": {
    "icon": 1.75,
    "focus": 2,
    "focusOffset": 2,
    "tabActive": 2
  },
  "motion": {
    "enterMs": 120,
    "exitMs": 80,
    "listMs": 100,
    "spinMs": 700,
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "enterY": 4
  },
  "brand": {
    "field-0": "#0B2018",
    "field-1": "#123426",
    "field-2": "#1D4D39",
    "accent": "#72DBA5",
    "accent-strong": "#A6E8C4",
    "highlight": "#E8FFF2",
    "frame": "#1C211E"
  },
  "deprecatedColor": {
    "renderer-accent": "#a5f4c5",
    "renderer-accent-strong": "#c8ffdc"
  },
  "styles": {
    "jia": {
      "label": "甲 · 玻璃",
      "panel": "rgb(11 32 24 / 88%)",
      "blur": "blur(20px) saturate(1.2)",
      "border": "1px solid rgb(232 255 242 / 12%)",
      "radiusPanel": 12,
      "shadow": "0 16px 40px rgb(0 8 5 / 38%)",
      "inset": "inset 0 1px 0 rgb(232 255 242 / 10%)",
      "inputBg": "rgb(2 17 10 / 45%)",
      "inputBorder": "rgb(114 219 165 / 32%)",
      "text": "#E8FFF2",
      "muted": "#9BB5A8",
      "accent": "#72DBA5",
      "optionActive": "rgb(114 219 165 / 16%)",
      "line": "rgb(114 219 165 / 18%)",
      "primaryFill": "#72DBA5",
      "primaryInk": "#123426",
      "danger": "#FFB5AC",
      "reducedTransparencyPanel": "#10261C"
