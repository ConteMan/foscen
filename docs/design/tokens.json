{
  "$comment": "Foscen overlay tokens for direction A. Values are CSS-ready. Direction B/C overrides live under variants.",
  "fontFamily": "Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
  "color": {
    "field-0": "#0B2018",
    "field-1": "#123426",
    "field-2": "#1D4D39",
    "panel": "rgb(11 32 24 / 92%)",
    "panel-solid": "#10261C",
    "text": "#E8FFF2",
    "muted": "#9BB5A8",
    "accent": "#72DBA5",
    "accent-strong": "#A6E8C4",
    "accent-ink": "#123426",
    "danger": "#FFB5AC",
    "danger-soft": "rgb(255 117 104 / 16%)",
    "line": "rgb(114 219 165 / 18%)",
    "line-strong": "rgb(114 219 165 / 32%)",
    "option-active": "rgb(114 219 165 / 14%)",
    "frame": "#1C211E",
    "paper": "#F3F1EB",
    "paper-ink": "#173427",
    "paper-muted": "#607168"
  },
  "deprecatedColor": {
    "renderer-accent": "#a5f4c5",
    "renderer-accent-strong": "#c8ffdc",
    "reason": "Brighter than brand focus green #72DBA5; do not use in new UI."
  },
  "type": {
    "input": { "size": 14, "weight": 500, "lineHeight": 20 },
    "optionTitle": { "size": 13, "weight": 600, "lineHeight": 18 },
    "optionMeta": { "size": 11, "weight": 400, "lineHeight": 16 },
    "footer": { "size": 11, "weight": 400, "lineHeight": 16 },
    "surfaceTitle": { "size": 15, "weight": 600, "lineHeight": 20 },
    "tab": { "size": 12, "weight": 500, "lineHeight": 16 },
    "tabActive": { "size": 13, "weight": 600, "lineHeight": 16 },
    "button": { "size": 13, "weight": 700, "lineHeight": 16 },
    "kicker": { "size": 11, "weight": 700, "lineHeight": 16, "letterSpacing": "0.08em" }
  },
  "space": {
    "unit": 8,
    "panelX": 8,
    "inputGap": 6,
    "optionX": 12,
    "footerX": 14,
    "footerGap": 14,
    "surfacePad": 16,
    "windowGap": 24
  },
  "size": {
    "omnibarMaxWidth": 640,
    "omnibarMaxHeight": 360,
    "surfaceMaxWidth": 720,
    "surfaceMaxHeight": 420,
    "dragStrip": 10,
    "inputRow": 44,
    "input": 36,
    "option": 40,
    "footer": 28,
    "iconButton": 28,
    "icon": 16,
    "close": 28,
    "brandMark": 24,
    "maxVisibleRows": 6,
    "maxVisibleRowsCompact": 4
  },
  "radius": {
    "panel": 12,
    "control": 8,
    "option": 8,
    "kbd": 5,
    "surfaceCard": 10
  },
  "stroke": {
    "icon": 1.75,
    "focus": 2,
    "focusOffset": 2,
    "tabActive": 2
  },
  "shadow": {
    "panel": "0 16px 40px rgb(0 8 5 / 38%)",
    "inset": "inset 0 1px 0 rgb(232 255 242 / 8%)",
    "invalidRing": "0 0 0 3px rgb(255 117 104 / 16%)",
    "focusRing": "0 0 0 3px rgb(114 219 165 / 18%)"
  },
  "blur": {
    "panel": "blur(20px) saturate(1.2)"
  },
  "motion": {
    "enterMs": 120,
    "exitMs": 80,
    "listMs": 100,
    "spinMs": 700,
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "enterY": 4
  },
  "layout": {
    "omnibarTopRatio": 0.14,
    "omnibarTopMin": 72,
    "omnibarTopMax": 140,
    "surfaceTopRatio": 0.1,
    "surfaceTopMin": 56,
    "surfaceTopMax": 96,
    "sideReserve": 48
  },
  "variants": {
    "B": {
      "size.omnibarMaxWidth": 600,
      "size.surfaceMaxWidth": 680,
      "size.surfaceMaxHeight": 400,
      "size.modeLabel": 52,
      "size.option": 38,
      "radius.panel": 14,
      "motion.morphMs": 160
    },
    "C": {
      "size.omnibarMaxWidth": 800,
      "size.surfaceMaxWidth": 800,
      "size.surfaceMaxHeight": 400,
      "size.option": 36,
      "size.header": 44,
      "size.tab": 36,
      "radius.panel": 10,
      "shadow.panel": "0 12px 32px rgb(0 8 5 / 32%)"
    }
  }
}
