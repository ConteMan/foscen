{
  "name": "foscen",
  "productName": "Foscen",
  "version": "0.2.2",
  "private": true,
  "description": "A focused, keyboard-first desktop container for web scenes.",
  "license": "MIT",
  "author": "ConteMan",
  "homepage": "https://github.com/ConteMan/foscen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConteMan/foscen.git"
  },
  "bugs": {
    "url": "https://github.com/ConteMan/foscen/issues"
  },
  "main": "dist/main/index.js",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.13.1"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.js --sourcemap && esbuild src/renderer/index.ts --bundle --platform=browser --format=iife --outfile=dist/renderer/index.js --sourcemap && node scripts/copy-static.mjs",
    "dev": "pnpm run build && electron .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "make:mac": "pnpm run build && electron-forge make --platform=darwin --arch=arm64",
    "package:mac": "pnpm run build && electron-forge package --platform=darwin --arch=arm64",
    "release:prepare:mac": "node scripts/validate-release.mjs && electron-forge publish --dry-run --platform=darwin --arch=arm64 && pnpm run verify:package",
    "release:upload:mac": "electron-forge publish --from-dry-run",
    "selftest": "./scripts/selftest.sh",
    "smoke": "node scripts/smoke.mjs",
    "start": "electron .",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "verify:config": "node scripts/verify-package.mjs --config-only",
    "verify:package": "node scripts/verify-package.mjs --artifacts"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/publisher-github": "7.11.2",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "electron": "43.4.0",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
